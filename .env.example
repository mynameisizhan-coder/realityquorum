# Copy to .env and fill in. Never commit .env.

# --- Required in production ---
NODE_ENV=production
# At least 32 random characters. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# --- Gemini (optional; without a key the offline mock is used) ---
GEMINI_API_KEY=
# Optional comma-separated list tried in order. Leave empty for the default: flash-lite for text, 3.7-flash for photos.
GEMINI_MODEL=

# --- Server ---
PORT=8791
# Defaults to 0.0.0.0 in production and 127.0.0.1 in development.
HOST=
# Where the SQLite database and uploaded files are stored. Must be persistent storage.
RQ_DATA_DIR=
# Built frontend folder. Defaults to ./dist.
STATIC_DIR=

# --- Security ---
# Secure cookies. Defaults to on in production; must be on when served over HTTPS, off only for plain-HTTP testing.
COOKIE_SECURE=
# Trust X-Forwarded-For from a reverse proxy (needed for correct rate limiting behind one). Defaults to on in production.
TRUST_PROXY=
# Requests per minute per client for Gemini-backed and write endpoints. 0 disables.
RATE_LIMIT_PER_MINUTE=60
# Demo role switcher: anyone can act as any role, including operator and trust officer.
# Keep on for a hackathon demo; turn off (false) once real authentication exists.
ALLOW_DEMO_LOGIN=true
